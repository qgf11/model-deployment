# Edit this file identically on all four machines. Bash syntax; no secrets.
P0_IP=10.26.2.14
P1_IP=10.26.2.15
D0_IP=10.26.2.16
D1_IP=10.26.2.17
# Set each node's NIC_NAME in node.env if interface names differ.
MODEL_PATH=/data1/DeepSeek-V4-Flash-0731-w8a8
IMAGE=quay.io/ascend/vllm-ascend:v0.26.0rc2
CONTAINER_NAME=dsv4-flash
LOG_ROOT=/data1/logs
SERVED_MODEL_NAME=deepseek
MAX_MODEL_LEN=262144
NUM_SPECULATIVE_TOKENS=7
P_DP_SIZE=4
P_TP_SIZE=2
D_DP_SIZE=16
D_TP_SIZE=1
DP_RPC_PORT=12321
VLLM_START_PORT=7100
PROXY_HOST=0.0.0.0
PROXY_PORT=1036
P_MAX_BATCHED_TOKENS=4096
P_MAX_SEQS=32
P_MEMORY_UTILIZATION=0.95
D_MAX_BATCHED_TOKENS=256
D_MAX_SEQS=32
D_MEMORY_UTILIZATION=0.96
# Set to 1 only for a controlled graph/eager comparison on BOTH D nodes.
D_ENFORCE_EAGER=0
SHM_SIZE=512g
